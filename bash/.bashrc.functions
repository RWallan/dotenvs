_fzf_comprun() {
  local command=$1
  shift

  case "$command" in
    cd)           fzf --preview 'eza --tree --color=always {} | head -200' "$@" ;;
    export|unset) fzf --preview "eval 'echo \$' {}" ;;
    ssh)          fzf --preview 'dig {}' ;;
    *)            fzf --preview 'bat -n --color=always --line-range :500 {}' "$@" ;;
  esac
}

# yazi: ao sair, o shell muda para o diretório em que você estava no yazi
y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

poetry() {
  if [[ $@ == "shell" ]]; then
    if ([[ -f "$(poetry env info -p)/bin/activate" ]] && [[ -z "${VIRTUAL_ENV:-}" ]]); then
      command source $(poetry env info -p)/bin/activate
    else
      command poetry "$@"
    fi
  else
    command poetry "$@"
  fi
}

activate_venv() {
  # Verifica se existe pyproject.toml no diretório atual
  if [[ -f "pyproject.toml" ]]; then
    if ([[ -z "${VIRTUAL_ENV:-}" ]]); then
      poetry shell
    elif [[ -f "$(poetry env info -p)/bin/activate" ]]; then
      command source $(poetry env info -p)/bin/activate
    fi
  fi
}

parse_git_branch() {
     git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}
