_fzf_comprun() {
  local command=$1
  shift

  case "$command" in
    cd)           fzf --preview 'eza --tree --level=2 --color=always --icons=always {} | head -200' "$@" ;;
    export|unset) fzf --preview "eval 'echo \$' {}" ;;
    *)            fzf --preview 'bat -n --color=always --line-range :500 {}' "$@" ;;
  esac
}

# **<Tab> do fzf lista caminhos com fd (respeita .gitignore, inclui ocultos)
_fzf_compgen_path() { fd --hidden --follow --exclude .git . "$1"; }
_fzf_compgen_dir() { fd --type d --hidden --follow --exclude .git . "$1"; }

# yazi: ao sair, o shell muda para o diretório em que você estava no yazi.
# Atalho: Alt-Y (a linha digitada vai para o kill ring; Ctrl-Y a recupera).
y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}
command -v yazi &> /dev/null && bind '"\ey": "\C-e\C-u y\C-m"'

# Ativa o .venv mais próximo (diretório atual ou acima). Serve para uv e poetry
# (o Ansible configura o poetry com virtualenvs.in-project = true).
# O Poetry 2.x não tem mais `poetry shell`.
activate() {
  local dir="$PWD"
  while :; do
    if [ -f "$dir/.venv/bin/activate" ]; then
      source "$dir/.venv/bin/activate"
      return
    fi
    [ -z "$dir" ] && break
    dir="${dir%/*}"
  done
  echo "Nenhum .venv encontrado (rode 'uv sync' ou 'poetry install')." >&2
  return 1
}

parse_git_branch() {
  git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}
